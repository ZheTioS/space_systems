# Frontend configuration (all optional — sensible defaults are built in)

# Spectrum display range (dBm)
# VITE_SPECTRUM_MIN_DB=-120
# VITE_SPECTRUM_MAX_DB=-20

# Waterfall history depth (rows)
# VITE_WATERFALL_ROWS=100

# Max upcoming passes shown in sidebar
# VITE_MAX_UPCOMING_PASSES=5

# SNR thresholds for color indicators (dB)
# VITE_SNR_GOOD_DB=10
# VITE_SNR_WARNING_DB=5

# WebSocket reconnection delay (ms)
# VITE_WS_RECONNECT_DELAY_MS=3000
