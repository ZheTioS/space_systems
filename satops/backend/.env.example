# Backend configuration (all optional — sensible defaults are built in)
# All variables are prefixed with SATOPS_

# Server
# SATOPS_HOST=127.0.0.1
# SATOPS_PORT=8000
# SATOPS_CORS_ORIGINS=["http://localhost:5173"]

# Database
# SATOPS_DB_PATH=satops.db

# SDR
# SATOPS_SDR_DRIVER=rtlsdr
# SATOPS_SDR_FREQUENCY_HZ=137100000
# SATOPS_SDR_SAMPLE_RATE=2048000
# SATOPS_SDR_GAIN=40.0
# SATOPS_SDR_FFT_SIZE=1024
# SATOPS_SDR_UPDATE_RATE_HZ=10.0
# SATOPS_SDR_QUEUE_SIZE=10

# TLE
# SATOPS_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=weather&FORMAT=tle
# SATOPS_TLE_TIMEOUT_S=30.0

# Link budget
# SATOPS_TX_POWER_DBM=37.0
# SATOPS_TX_GAIN_DBI=5.0
# SATOPS_RX_GAIN_DBI=3.0
# SATOPS_SYSTEM_LOSSES_DB=2.0
# SATOPS_NOISE_FIGURE_DB=3.5
# SATOPS_BANDWIDTH_HZ=34000.0

# Tracking
# SATOPS_MIN_PASS_ELEVATION_DEG=5.0
# SATOPS_TRACKING_ELEVATION_THRESHOLD_DEG=-5.0
# SATOPS_WS_UPDATE_INTERVAL_S=0.1

# Observer location
# SATOPS_OBSERVER_LAT=52.52
# SATOPS_OBSERVER_LON=13.405
# SATOPS_OBSERVER_ELEV_M=34.0
